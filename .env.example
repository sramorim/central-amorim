# Central Amorim — variáveis de ambiente (Worker)

# Origem pública usada nos links de redirecionamento (ex.: https://central.senhoramorim.com.br)
PUBLIC_ORIGIN=https://central.senhoramorim.com.br

# Domínio do cookie de sessão compartilhada entre subdomínios (ex.: .senhoramorim.com.br)
COOKIE_DOMAIN=.senhoramorim.com.br

# Se o cookie deve exigir HTTPS (true em produção)
COOKIE_SECURE=true

# E-mails com acesso administrativo (Admin se cadastrarem na plataforma)
# Ex.: ADMIN_EMAILS=daniel@senhoramorim.com.br,admin@senhoramorim.com.br
ADMIN_EMAILS=

# --- Login com Google (opcional) ---
# Deixar vazio desativa o botão "Continuar com Google" na interface.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (recuperação de senha, via Resend) ---
# Deixar vazio desativa o envio; a recuperação avisa que "Se o e-mail existir...".
RESEND_API_KEY=
MAIL_FROM=Central Amorim <no-reply@senhoramorim.com.br>
# --- Pagamento por Pix (chave estática, sem PSP — confirmação manual no painel) ---
# Chave Pix que recebe os pagamentos (recomendado: e-mail dedicado do projeto).
PIX_KEY=
PIX_NAME=SR. AMORIM
PIX_CITY=BRASIL
PIX_AMOUNT_BRL=9.99
# Número do WhatsApp Business que recebe os comprovantes (com DDD, sem +55).
WA_NUMBER=

# --- Ferramentas SHANDON ELITE hospedadas aqui (provisório: Workers grátis) ---
# Origem permitida no CORS/origin-check (site Shandon).
SHANDON_ORIGIN=https://elite.senhoramorim.com.br
# --- WhatsApp Lookup: provedor PRINCIPAL = Apify (WhatsApp Data Lookup) ---
# Plano Free do Apify dá ~US$5/mês de crédito, sem cartão (1.000+ consultas ricas).
# SECRET: nunca commit. Definir no Cloudflare Dashboard (Settings > Variables > Secrets).
APIFY_API_TOKEN=
# Limite diário de consultas Apify por instância do Worker (WhatsApp + Instagram
# compartilham o mesmo orçamento; ~US$5/mês no plano Free).
APIFY_DAILY_LIMIT=40
# --- WhatsApp Lookup: provedor FALLBACK = RapidAPI (WhatsApp OSINT) ---
# SECRET. Definir no Cloudflare Dashboard (Settings > Variables > Secrets).
RAPIDAPI_WHATSAPP_KEY=
